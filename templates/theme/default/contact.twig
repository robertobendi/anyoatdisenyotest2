{% extends "@theme/layout.twig" %}

{% block title %}Start Your Build — Contact Anyo at Disenyo{% endblock %}
{% block meta_description %}Tell Anyo at Disenyo about your Batangas project — lot, budget, and plans — using the brief form, or reach us on Facebook. We reply with honest next steps.{% endblock %}
{% block og_title %}Start Your Build — Contact Anyo at Disenyo{% endblock %}

{% block head %}
<style>
    .contact-grid { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: start; }

    .brief-form .field { margin-bottom: 1.7rem; }
    .brief-form .lbl { display: block; font-family: var(--sans); font-weight: 600; font-size: .75rem; text-transform: uppercase; letter-spacing: .1em; color: var(--taupe); margin-bottom: .5rem; }
    .brief-form input,
    .brief-form select,
    .brief-form textarea {
        width: 100%; border: 0; border-bottom: 1px solid var(--walnut);
        background: transparent; font-family: var(--sans); font-size: 16px; color: var(--ink);
        padding: .65rem .1rem; line-height: 1.4; border-radius: 0; min-height: 46px;
        transition: border-color .15s ease, box-shadow .15s ease;
    }
    .brief-form textarea { min-height: 120px; resize: vertical; }
    .brief-form select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--taupe) 50%), linear-gradient(135deg, var(--taupe) 50%, transparent 50%); background-position: right 6px center, right 1px center; background-size: 6px 6px, 6px 6px; background-repeat: no-repeat; padding-right: 1.4rem; }
    .brief-form input:focus,
    .brief-form select:focus,
    .brief-form textarea:focus { outline: none; border-bottom: 2px solid var(--moss); box-shadow: 0 1px 0 0 var(--moss); }
    .brief-form input::placeholder, .brief-form textarea::placeholder { color: #a39a8f; }
    .form-help { font-size: .85rem; color: var(--ink-soft); margin-top: 1.25rem; }

    .contact-card { background: var(--espresso); color: var(--paper); border-radius: 4px; padding: clamp(1.8rem, 3.5vw, 2.6rem); box-shadow: 0 24px 50px rgba(42,38,32,.28); }
    .contact-card h2 { font-family: var(--display); text-transform: uppercase; font-size: 1.6rem; color: var(--paper); margin: 0 0 1.25rem; }
    .contact-card .row { display: block; padding: 1rem 0; border-top: 1px solid rgba(246,242,234,.15); }
    .contact-card .row:first-of-type { border-top: 0; padding-top: 0; }
    .contact-card .rlabel { font-family: var(--sans); font-weight: 600; font-size: .72rem; text-transform: uppercase; letter-spacing: .1em; color: #b7a98f; display: block; margin-bottom: .3rem; }
    .contact-card .rval, .contact-card .rval a { color: var(--paper); font-size: 1.02rem; text-decoration: none; }
    .contact-card .rval a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .contact-card address { font-style: normal; }

    @media (min-width: 860px) {
        .contact-grid { grid-template-columns: 1.15fr 360px; gap: 4rem; }
        .contact-card { transform: translateX(-44px); position: relative; z-index: 3; margin-top: 1.5rem; }
    }
</style>
{% endblock %}

{% block content %}
<section class="hero hero--band hero--drift" aria-label="Contact">
    <div class="hero__img"><img src="/uploads/ext-dusk.jpg" alt="A nearly finished home glowing warmly in the evening"></div>
    <div class="hero__inner wrap">
        <p class="eyebrow hero__eyebrow">Magpasimula · Get started</p>
        <h1>Start Your Build</h1>
    </div>
</section>

<section class="section">
    <div class="wrap contact-grid">
        <!-- brief form -->
        <div class="reveal">
            <p class="eyebrow">Your brief</p>
            <h2 class="h2">Tell us about your project</h2>
            <p class="muted" style="margin:1rem 0 2rem; max-width: 46ch;">The more you share, the better our first reply. There's no obligation — just an honest read on what's possible.</p>

            <!-- TODO: replace REPLACE_ME with the firm's real Formspree form ID (https://formspree.io/f/xxxxxxxx).
                 Until then the Facebook link in the card beside this form is the working way to reach us. -->
            <form class="brief-form" action="https://formspree.io/f/REPLACE_ME" method="POST">
                <div class="field">
                    <label class="lbl" for="f-name">Your name</label>
                    <input id="f-name" name="name" type="text" required autocomplete="name" placeholder="Juan dela Cruz">
                </div>
                <div class="field">
                    <label class="lbl" for="f-contact">Contact number</label>
                    <input id="f-contact" name="contact" type="text" required autocomplete="tel" inputmode="tel" placeholder="So we can reply quickly">
                </div>
                <div class="field">
                    <label class="lbl" for="f-location">Project location</label>
                    <input id="f-location" name="location" type="text" autocomplete="address-level2" placeholder="e.g. Batangas City, Lipa, Bauan">
                </div>
                <div class="field">
                    <label class="lbl" for="f-type">Project type</label>
                    <select id="f-type" name="project_type">
                        <option>New home</option>
                        <option>Renovation</option>
                        <option>Commercial</option>
                        <option>Planning / permits</option>
                        <option>Not sure yet</option>
                    </select>
                </div>
                <div class="field">
                    <label class="lbl" for="f-message">About your project</label>
                    <textarea id="f-message" name="message" required placeholder="Your lot size, rough budget, and what you'd love to build."></textarea>
                </div>
                <input type="text" name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;">
                <p><button type="submit" class="pill">Get Your Brief <span class="arrow" aria-hidden="true">&rarr;</span></button></p>
                <p class="form-help">Prefer to message? Reach us any time on <a href="https://www.facebook.com/anyoatdisenyo" target="_blank" rel="noopener">our Facebook page</a> — it's the quickest way to start a conversation today.</p>
            </form>
        </div>

        <!-- espresso contact card (grid-breaking dark block) -->
        <aside class="contact-card reveal">
            <h2>Reach us</h2>
            <address>
                <div class="row">
                    <span class="rlabel">Studio</span>
                    <span class="rval">Batangas City, Philippines</span>
                </div>
                <div class="row">
                    <span class="rlabel">Message</span>
                    <span class="rval"><a href="https://www.facebook.com/anyoatdisenyo" target="_blank" rel="noopener">facebook.com/anyoatdisenyo</a></span>
                </div>
                <div class="row">
                    <span class="rlabel">Serving</span>
                    <span class="rval">Batangas &amp; nearby towns</span>
                </div>
                <div class="row">
                    <span class="rlabel">Find Batangas City</span>
                    <span class="rval"><a href="https://www.openstreetmap.org/?mlat=13.7565&mlon=121.0583#map=13/13.7565/121.0583" target="_blank" rel="noopener">Open in OpenStreetMap</a></span>
                </div>
            </address>
            <!-- TODO: add the firm's verified phone, email, and opening hours here once confirmed. -->
            <p style="color:#d8cfc0; font-size:.92rem; margin:1.5rem 0 1.4rem;">We usually reply within a day. Tell us your timeline and we'll work to it.</p>
            <a class="pill" href="https://www.facebook.com/anyoatdisenyo" target="_blank" rel="noopener">Message on Facebook <span class="arrow" aria-hidden="true">&rarr;</span></a>
        </aside>
    </div>
</section>
{% endblock %}
