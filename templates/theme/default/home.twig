{% extends "@theme/layout.twig" %}

{% block title %}Anyo at Disenyo — Architectural Services in Batangas City{% endblock %}
{% block meta_description %}Licensed Batangas architects who turn your idea into buildable, beautiful plans — from first sketch to finished build. Get your project brief started today.{% endblock %}
{% block og_title %}Anyo at Disenyo — We shape the home you'll live in{% endblock %}

{% block head %}
<style>
    /* ---------- HOME-SPECIFIC ---------- */
    .proof-layout { display: grid; grid-template-columns: minmax(0,1fr); gap: 2rem; align-items: start; }
    .stats { display: flex; flex-wrap: wrap; gap: 2rem 3.25rem; }
    .stat { min-width: 0; max-width: 18ch; }
    .stat .stat-cap { font-size: .95rem; color: var(--ink-soft); margin-top: .5rem; line-height: 1.45; }
    .proof-callout { align-self: start; }

    .manifesto-grid { display: grid; grid-template-columns: 1fr; gap: 2.25rem; align-items: center; }
    .manifesto-line { color: var(--moss); font-weight: 500; }
    .home-duo { position: relative; overflow: hidden; border-radius: 4px; box-shadow: 14px 16px 0 -2px rgba(110,112,68,.20), 0 18px 42px rgba(42,38,32,.16); }
    .home-duo::after { content: ""; position: absolute; inset: 0; pointer-events: none; background: linear-gradient(150deg, rgba(110,112,68,.12), rgba(42,38,32,.06) 60%); mix-blend-mode: multiply; }
    .home-duo img { width: 100%; aspect-ratio: 4/5; object-fit: cover; display: block; filter: saturate(1.05) contrast(1.03); transition: transform .55s ease; }
    .home-duo:hover img { transform: scale(1.035); }
    .home-duo figcaption { position: absolute; left: 0; right: 0; bottom: 0; z-index: 1; padding: 1.6rem 1.3rem .95rem; color: var(--paper); font-family: var(--serif); font-size: 1.05rem; background: linear-gradient(0deg, rgba(20,18,15,.62), transparent); }

    .svc-grid { display: grid; grid-template-columns: 1fr; gap: 1.25rem; margin-top: 2.5rem; }
    .svc-card { background: var(--sand); padding: clamp(1.5rem,3vw,2.1rem); border-top: 3px solid var(--moss); border-radius: 3px; transition: transform .18s ease, box-shadow .18s ease; }
    .svc-card:hover { transform: translateY(-4px); box-shadow: 0 18px 36px rgba(42,38,32,.12); }
    .svc-card h3 { margin: 0 0 .5rem; }
    .svc-card p { color: var(--ink-soft); margin: 0; font-size: .98rem; }

    /* full-bleed photo band */
    .band { position: relative; width: 100vw; margin-left: calc(50% - 50vw); min-height: clamp(300px, 40vw, 480px); display: flex; align-items: center; overflow: hidden; isolation: isolate; }
    .band img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
    .band::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgba(20,18,15,.74) 0%, rgba(20,18,15,.34) 55%, rgba(20,18,15,.12) 100%); }
    .band__cap { font-family: var(--serif); color: var(--paper); font-size: clamp(1.5rem, 3.6vw, 2.6rem); line-height: 1.18; max-width: 22ch; text-shadow: 0 2px 18px rgba(0,0,0,.4); }
    .band__cap .eyebrow { color: #d8cdb6; }

    .feat-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 1rem; }
    .feat-grid { display: grid; grid-template-columns: 1fr; gap: 1.75rem; margin-top: 2.5rem; }
    .feat-card { background: var(--sand); padding: 12px 12px 1.1rem; border-radius: 3px; box-shadow: 12px 14px 0 -2px rgba(138,106,77,.34); transition: transform .18s ease, box-shadow .18s ease; text-decoration: none; color: inherit; display: block; }
    .feat-card:hover { transform: translate(-2px,-2px); box-shadow: 16px 18px 0 -2px rgba(138,106,77,.46); }
    .feat-card .frame { overflow: hidden; border-radius: 2px; display: block; }
    .feat-card img { width: 100%; aspect-ratio: 4/3; object-fit: cover; transition: transform .4s ease; }
    .feat-card:hover img { transform: scale(1.04); }
    .feat-cap { margin-top: .9rem; display: block; }
    .feat-cap .name { font-family: var(--serif); font-size: 1.2rem; display: block; color: var(--ink); }
    .feat-cap .meta { font-size: .8125rem; text-transform: uppercase; letter-spacing: .08em; color: var(--taupe); margin-top: .25rem; display: block; }

    .closing { display: grid; grid-template-columns: 1fr; gap: 2.5rem; align-items: start; }
    .spec-table { width: 100%; border-collapse: collapse; }
    .spec-table th, .spec-table td { text-align: left; padding: 1rem 0; border-top: 1px solid var(--hairline); vertical-align: baseline; font-weight: 400; }
    .spec-table th { font-family: var(--sans); font-weight: 600; font-size: .8125rem; text-transform: uppercase; letter-spacing: .08em; color: var(--taupe); width: 42%; }
    .spec-table td { color: var(--ink); }
    .closing-cta { margin-top: 2rem; }

    @media (min-width: 760px) {
        .manifesto-grid { grid-template-columns: 1.4fr .85fr; gap: 3.5rem; }
        .svc-grid { grid-template-columns: repeat(3,1fr); }
        .feat-grid { grid-template-columns: repeat(3,1fr); }
        .closing { grid-template-columns: 1.05fr .95fr; gap: 4rem; align-items: end; }
    }
    @media (min-width: 900px) {
        .proof-layout { grid-template-columns: minmax(0,1fr) 340px; gap: 4rem; }
        .proof-callout { transform: translateX(-44px); margin-top: -72px; position: relative; z-index: 4; }
    }
</style>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Anyo at Disenyo — Architectural Services",
  "url": "{{ site.url }}",
  "logo": "{{ site.url }}/uploads/logo.jpg",
  "image": "{{ site.url }}/uploads/logo.jpg",
  "description": "Licensed architectural-services firm in Batangas City, Philippines — architectural design, planning and permits, and project development for homes and small properties.",
  "address": { "@type": "PostalAddress", "addressLocality": "Batangas City", "addressRegion": "Batangas", "addressCountry": "PH" },
  "areaServed": "Batangas, Philippines",
  "knowsLanguage": ["en", "tl"],
  "sameAs": ["https://www.facebook.com/anyoatdisenyo"]
}
</script>
{% endblock %}

{% block content %}
<section class="hero hero--drift" aria-label="Introduction">
    <div class="hero__img"><img src="/uploads/hero-home.jpg" alt="Warm, light-filled living room with wooden paneling under a high ceiling" loading="eager" fetchpriority="high"></div>
    <div class="hero__inner wrap">
        <p class="eyebrow hero__eyebrow">Architectural Services · Batangas City</p>
        <h1>WE SHAPE THE HOME YOU'LL LIVE IN</h1>
        <p class="hero__sub">Anyo at Disenyo turns a Batangas family's idea into buildable, beautiful plans — licensed architects who stay with you from first sketch to finished build.</p>
        <p class="hero__cta"><a class="pill" href="/contact">Get Your Brief <span class="arrow" aria-hidden="true">&rarr;</span></a></p>
    </div>
</section>

<!-- 2 · Proof row: oversized numerals + grid-breaking espresso card -->
<section class="section proof">
    <div class="wrap">
        <p class="eyebrow reveal">Proof, not promises</p>
        <h2 class="h2 reveal" style="max-width: 18ch;">Why Batangas families build with us</h2>
        <div class="proof-layout" style="margin-top: 2.75rem;">
            <div class="stats reveal">
                <div class="stat">
                    <span class="num">12</span>
                    <span class="stat-cap">Years turning ideas into buildable plans across Batangas.</span>
                </div>
                <div class="stat">
                    <span class="num">80+</span>
                    <span class="stat-cap">Homes and projects drawn, permitted, and delivered.</span>
                </div>
                <div class="stat">
                    <span class="num">PRC</span>
                    <span class="stat-cap">A licensed architect's stamp on every set of plans.</span>
                </div>
            </div>
            <aside class="callout proof-callout reveal">
                <p class="eyebrow eyebrow--light">Start here</p>
                <p class="callout__lead">Tell us about your site.</p>
                <p>Send a few details about your lot and what you want to build. We'll reply with honest next steps — no obligation.</p>
                <p style="margin-top:1.3rem;"><a class="pill" href="/contact">Get Your Brief <span class="arrow" aria-hidden="true">&rarr;</span></a></p>
            </aside>
        </div>
    </div>
</section>

<hr class="rule">

<!-- 3 · Manifesto + duotone still-life -->
<section class="section">
    <div class="wrap manifesto-grid reveal">
        <div>
            <p class="eyebrow">Form and design</p>
            <p class="lead"><span class="manifesto-line">anyo at disenyo — form and design.</span> A home is the biggest thing most families ever build. We treat it that way: listening first, drawing carefully, and standing beside you from the first sketch to the day you move in.</p>
        </div>
        <figure class="home-duo" style="margin:0;">
            <img src="/uploads/still.jpg" alt="A dining table set for a family meal against a warm wood-slat wall">
            <figcaption>The everyday rooms, designed with care.</figcaption>
        </figure>
    </div>
</section>

<!-- 4 · Services row -->
<section class="section">
    <div class="wrap">
        <p class="eyebrow reveal">What we do</p>
        <h2 class="h2 reveal">From first idea to finished build</h2>
        <div class="svc-grid">
            <article class="svc-card reveal">
                <p class="eyebrow eyebrow--ink">01 · Design</p>
                <h3 class="h3">Architectural Design</h3>
                <p>We shape the form and feel of your home — plans, elevations, and the small decisions that make a house yours.</p>
            </article>
            <article class="svc-card reveal">
                <p class="eyebrow eyebrow--ink">02 · Permits</p>
                <h3 class="h3">Planning &amp; Permits</h3>
                <p>Buildable drawings and the documentation your project needs to clear local requirements without the guesswork.</p>
            </article>
            <article class="svc-card reveal">
                <p class="eyebrow eyebrow--ink">03 · Build</p>
                <h3 class="h3">Project Development</h3>
                <p>We stay involved through construction so what gets built matches what we drew — and what you pictured.</p>
            </article>
        </div>
        <p style="margin-top:2rem;" class="reveal"><a class="text-link" href="/services">See how a project starts</a></p>
    </div>
</section>

<!-- mid-page full-bleed band with Fraunces caption -->
<section class="band reveal" aria-label="Featured photograph">
    <img src="/uploads/int-kitchen.jpg" alt="Warm kitchen with timber millwork and exposed brick in golden afternoon light">
    <div class="wrap">
        <p class="band__cap"><span class="eyebrow">On the boards in Batangas</span>Concrete, timber, and warm light — drawn for the way you actually live.</p>
    </div>
</section>

<!-- 5 · Featured work -->
<section class="section">
    <div class="wrap">
        <div class="feat-head">
            <div>
                <p class="eyebrow reveal">Selected work</p>
                <h2 class="h2 reveal">Built, and standing</h2>
            </div>
            <a class="text-link reveal" href="/work">View all work</a>
        </div>
        <div class="feat-grid">
            <a class="feat-card reveal" href="/work">
                <span class="frame"><img src="/uploads/ext-jacobs1.jpg" alt="Single-storey residence with deep eaves and a brick and timber facade"></span>
                <span class="feat-cap"><span class="name">Hillside Family Residence</span><span class="meta">Residential · Batangas · 2023</span></span>
            </a>
            <a class="feat-card reveal" href="/work">
                <span class="frame"><img src="/uploads/ext-schweiker.jpg" alt="Low modern house and studio set among mature trees"></span>
                <span class="feat-cap"><span class="name">Studio &amp; Annex</span><span class="meta">Renovation · Batangas · 2022</span></span>
            </a>
            <a class="feat-card reveal" href="/work">
                <span class="frame"><img src="/uploads/int-living.jpg" alt="Bright modern living room opening to the outdoors"></span>
                <span class="feat-cap"><span class="name">Open-Plan Family Home</span><span class="meta">Residential · Batangas · 2024</span></span>
            </a>
        </div>
    </div>
</section>

<hr class="rule">

<!-- 6 · Closing block: heading vs right-aligned spec/stat table -->
<section class="section">
    <div class="wrap closing">
        <div class="reveal">
            <p class="eyebrow">Start your build</p>
            <h2 class="h2" style="font-size: clamp(2.25rem,4.5vw,3.5rem);">Ready when you are</h2>
            <p class="muted" style="margin-top:1rem; max-width: 34ch;">Tell us about your lot and your plans. We'll come back with a clear, honest path forward.</p>
            <p class="closing-cta"><a class="pill" href="/contact">Get Your Brief <span class="arrow" aria-hidden="true">&rarr;</span></a></p>
        </div>
        <div class="reveal">
            <table class="spec-table">
                <tbody>
                    <tr><th scope="row">Practice</th><td>Anyo at Disenyo — Architectural Services</td></tr>
                    <tr><th scope="row">Based in</th><td>Batangas City, Philippines</td></tr>
                    <tr><th scope="row">Services</th><td>Design · Planning &amp; permits · Project development</td></tr>
                    <tr><th scope="row">Works in</th><td>English &amp; Tagalog</td></tr>
                    <tr><th scope="row">Find us</th><td><a href="https://www.facebook.com/anyoatdisenyo" target="_blank" rel="noopener">facebook.com/anyoatdisenyo</a></td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>
{% endblock %}
