{% extends "@theme/layout.twig" %}

{% block title %}About the Practice — Anyo at Disenyo Architectural Services{% endblock %}
{% block meta_description %}Anyo at Disenyo is an owner-led, PRC-licensed architectural practice in Batangas City — form and design, rooted locally, here for the long build.{% endblock %}
{% block og_title %}Form, Then Design — About Anyo at Disenyo{% endblock %}

{% block head %}
<style>
    .about-intro { display: grid; grid-template-columns: 1fr; gap: 2rem; align-items: center; }
    .about-logo { background: var(--paper); border-radius: 12px; padding: clamp(1.5rem,4vw,2.5rem); display: flex; justify-content: center; box-shadow: 0 18px 40px rgba(42,38,32,.10); }
    .about-logo img { width: clamp(150px, 30vw, 210px); height: auto; }
    .about-intro .lead { margin: 0; }

    /* warm, stronger bottom-left scrim so "FORM, THEN DESIGN" is the single focal point */
    .hero::after {
        background:
            linear-gradient(180deg, rgba(30,26,21,.32) 0%, rgba(30,26,21,0) 34%, rgba(30,26,21,.42) 60%, rgba(30,26,21,.86) 100%),
            linear-gradient(80deg, rgba(30,26,21,.58) 0%, rgba(30,26,21,.12) 46%, rgba(30,26,21,0) 70%);
    }

    .principal { display: grid; grid-template-columns: 1fr; gap: 2.25rem; align-items: center; }
    .principal .frame { position: relative; overflow: hidden; border-radius: 3px; background: var(--sand); box-shadow: 12px 14px 0 -2px rgba(138,106,77,.20), 0 18px 42px rgba(42,38,32,.14); }
    .principal .frame::after { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: linear-gradient(150deg, rgba(110,112,68,.12), rgba(42,38,32,.06) 60%); mix-blend-mode: multiply; }
    .principal img { width: 100%; aspect-ratio: 3/4; object-fit: cover; display: block; filter: saturate(1.05) contrast(1.03); transition: transform .55s ease; }
    .principal .frame:hover img { transform: scale(1.035); }
    .principal .copy { max-width: 50ch; }
    .principal h3 { margin: 0 0 .6rem; }
    .principal p { color: var(--ink-soft); }

    .about-stats { display: flex; flex-wrap: wrap; gap: 2.25rem 3.5rem; margin-top: 2.75rem; }
    .about-stat { min-width: 0; max-width: 17ch; }
    .about-stat .stat-cap { font-size: .95rem; color: var(--ink-soft); margin-top: .5rem; line-height: 1.45; }

    @media (min-width: 760px) {
        .about-intro { grid-template-columns: minmax(0,300px) 1fr; gap: 3.5rem; }
        .principal { grid-template-columns: minmax(0,320px) 1fr; gap: 3.5rem; }
    }
</style>
{% endblock %}

{% block content %}
<section class="hero hero--band hero--drift" aria-label="About the practice">
    <div class="hero__img"><img src="/uploads/int-hallway.jpg" alt="Warm timber-lined hallway with full-height windows receding into soft daylight" loading="eager" fetchpriority="high"></div>
    <div class="hero__inner wrap">
        <p class="eyebrow hero__eyebrow">The practice</p>
        <h1>Form, Then Design</h1>
    </div>
</section>

<!-- logo lock-up + bilingual Fraunces manifesto -->
<section class="section">
    <div class="wrap about-intro reveal">
        <div class="about-logo">
            <img src="/uploads/logo.jpg" width="210" height="210" alt="Anyo at Disenyo — Architectural Services full logo lock-up with the interlocking 'ad' monogram">
        </div>
        <div>
            <p class="eyebrow">Anyo at Disenyo</p>
            <p class="lead"><span style="color:var(--moss);font-weight:500;">anyo at disenyo — form and design.</span> Ibig sabihin: anyo at disenyo. We're a small, owner-led architectural practice in Batangas City that believes a good home begins with listening — to your family, your lot, and the way the light falls — long before the first line is drawn.</p>
        </div>
    </div>
</section>

<hr class="rule">

<!-- principal / practice intro -->
<section class="section">
    <div class="wrap principal reveal">
        <div class="frame"><img src="/uploads/int-studio.jpg" alt="The Anyo at Disenyo studio — a drawing table and shelves in warm light"></div>
        <div class="copy">
            <p class="eyebrow">The people behind it</p>
            <h2 class="h2">A licensed architect, on every plan</h2>
            <p style="margin-top:1rem;">Anyo at Disenyo is led by a PRC-licensed architect who works directly with each family — no handing your project down a chain of juniors. That means the person who hears your idea is the same one who draws it and checks the build.</p>
            <p>We're rooted here in Batangas, and we plan to be for a long time. Most of our work comes from neighbours and the families they refer — which is exactly the kind of practice we set out to be.</p>
        </div>
    </div>
</section>

<!-- oversized stat numerals -->
<section class="section section--tight">
    <div class="wrap">
        <p class="eyebrow reveal">By the numbers</p>
        <h2 class="h2 reveal">Steady hands, local roots</h2>
        <div class="about-stats reveal">
            <div class="about-stat">
                <span class="num">12</span>
                <span class="stat-cap">Years designing and developing homes across Batangas.</span>
            </div>
            <div class="about-stat">
                <span class="num">80+</span>
                <span class="stat-cap">Projects drawn, permitted, and delivered for local families.</span>
            </div>
            <div class="about-stat">
                <span class="num">PRC</span>
                <span class="stat-cap">Licensed and accountable — a real architect's stamp on the work.</span>
            </div>
        </div>
    </div>
</section>

<hr class="rule">

<section class="section">
    <div class="wrap reveal" style="text-align:center; max-width: 40ch; margin-inline:auto;">
        <p class="eyebrow">Let's talk</p>
        <h2 class="h2">Build with people who stay</h2>
        <p class="muted" style="margin-top:1rem;">Tell us about your project and we'll show you how we'd approach it.</p>
        <p style="margin-top:1.75rem;"><a class="pill" href="/contact">Get Your Brief <span class="arrow" aria-hidden="true">&rarr;</span></a></p>
    </div>
</section>
{% endblock %}
